# Owl Nesting — SERVER ONLY. Paste these into Vercel (Production / Preview) as needed.
# Do not use NEXT_PUBLIC_* for any of these.

# Sellout gate before staking is allowed (see lib/nesting/policy.ts).
# If REQUIRED=true: opens when now >= SELL_OUT_AT, or when REACHED is true (defaults true if unset).
NESTING_SELL_OUT_REQUIRED=true
NESTING_SELL_OUT_REACHED=true
# NESTING_SELL_OUT_AT=2026-12-31T00:00:00.000Z

# Emergency / maintenance: set to true to reject stake, claim, and unstake server-side (see policy.ts).
# NESTING_DISABLED=true
# Suggested default OWL/day rate for a new NFT perch (UI hint only — no longer hard-enforced).
NESTING_OWL_DAILY_REWARD_PER_NFT=1
# Allowed OWL/day band each NFT perch's reward_rate must fall within (lock-tiered perches earn different
# rates, e.g. Gen2 90-day=0.1, 180-day=0.3, canonical=1). Defaults: min 0, max 100. Widen/tighten as needed.
# NESTING_OWL_DAILY_REWARD_MIN=0
# NESTING_OWL_DAILY_REWARD_MAX=100

# MPL Core + Gen 2 Token Metadata nest freeze authority.
# Gen 1 / Owltopia coins: FreezeDelegate plugin authority (wallet signs lock).
# Gen 2 (Metaplex V1): holder Approves this wallet as SPL delegate; server FreezeDelegatedAccount.
# Must match NESTING_NFT_FREEZE_AUTHORITY_SECRET_KEY.
NESTING_NFT_FREEZE_AUTHORITY_WALLET=
# Signing key for that authority (JSON byte array or base58).
NESTING_NFT_FREEZE_AUTHORITY_SECRET_KEY=

# OWL payouts for claims — public treasury + signing keypair (reward payouts, not platform fee collection)
# Also hosts partner reward ATAs: partners deposit their SPL into this wallet's ATA for pool.reward_mint;
# nesters claim from those deposits via /partners/dashboard → Fund reward pool.
NESTING_OWL_REWARD_TREASURY_WALLET=
NESTING_OWL_REWARD_TREASURY_SECRET_KEY=

# Gen Owl monthly SOL/USDC rev share — dedicated pool (NOT raffle funds escrow).
# Admin deposits from their connected wallet into this pool; nesters claim from it.
# Secret: JSON byte array or base58. Optional WALLET must match the secret's public key when set.
GEN_OWL_REV_SHARE_POOL_SECRET_KEY=
# GEN_OWL_REV_SHARE_POOL_WALLET=

# Staking platform fees (when implemented) use OWL_PLATFORM_FEE_TREASURY_WALLET — see .env.example.
# Allow claims to update the DB only (no SPL transfer). Default off — omit unless you need MVP-style testing.
# Records execution_path=database_only in staking_reward_events (app ledger).
# NESTING_ALLOW_DB_ONLY_OWL_CLAIMS=true

# Claim-all: server batches large wallets (default 25 nests per on-chain payout). See lib/nesting/chunked-claim-all.ts
# NESTING_CLAIM_ALL_BATCH_SIZE=25
# NESTING_CLAIM_ALL_DISABLED=true

# OWL token staking vault signer. Required for on-chain unstake releases.
# For the Council governance perch, this can be the same key as COUNCIL_OWL_ESCROW_SECRET_KEY.
NESTING_STAKE_VAULT_SECRET_KEY=

# Collection fallback when staking_pools.collection_key is unset (optional if DB has collection_key).
# Canonical Owl Nest collection (must match staking_pools.collection_key for owl-nest-365 after migration 106).
NESTING_OWLTOPIA_COIN_COLLECTION_ADDRESS=EZdgJQao3v33F723EsC1QqfwvuDRyVkCMsZTW8Z6JTpB

# Global Owl Nest progress bar on /nesting (all wallets): staked count vs Owltopia coin supply (default 1000).
# NESTING_OWL_NEST_GLOBAL_CAPACITY=1000
# NEXT_PUBLIC_NESTING_OWL_NEST_GLOBAL_CAPACITY=1000

# Gen 1 / Gen 2 community nest progress bars on /nesting (all wallets; defaults 343 / 2000).
# NESTING_GEN1_OWL_GLOBAL_CAPACITY=343
# NEXT_PUBLIC_NESTING_GEN1_OWL_GLOBAL_CAPACITY=343
# NESTING_GEN2_OWL_GLOBAL_CAPACITY=2000
# NEXT_PUBLIC_NESTING_GEN2_OWL_GLOBAL_CAPACITY=2000

# ── Owltopia Coin art upgrade (community vote) ────────────────────────────────
# Optional paid upgrade: holder pays the fee, server repoints the coin's MPL Core
# URI to the new Arweave art (works while nested — freeze only blocks transfers),
# and the coin earns reward_multiplier × OWL while nested.
# Ship dark: leave ENABLED unset until the vote passes and the catalog is seeded
# (scripts/upload-coin-upgrade-irys.mjs then scripts/seed-coin-upgrade-catalog.mjs).
# COIN_ART_UPGRADE_ENABLED=true
# COIN_ART_UPGRADE_FEE_SOL=0.1
# COIN_ART_UPGRADE_REWARD_MULTIPLIER=2
#
# Option A (recommended) — server hot key, Gembird keeps root authority cold:
#   1. Admin → Coin art upgrade → "Create hot key" (stored in DB; no CLI).
#      Fund the shown address with a little SOL.
#   2. Copy authorize link → send Gembird https://…/coin-upgrade/authorize
#      He connects collection wallet (7PRb9…) in Phantom → taps Approve.
#   3. Page says "Already authorized".
# Optional override: set COIN_ART_UPGRADE_AUTHORITY_* in Vercel instead of Admin create
# (env wins over the DB hot key). JSON byte array or base58.
# COIN_ART_UPGRADE_AUTHORITY_SECRET_KEY=
# COIN_ART_UPGRADE_AUTHORITY_WALLET=
# Fees are collected into OWL_PLATFORM_FEE_TREASURY_WALLET (see .env.example).
